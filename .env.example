# Optional. Copy to .env to override the defaults in docker-compose.yml.
# Never commit a real .env.

# Product data. If Fake Store is unreachable, the API serves a bundled snapshot instead.
FAKESTORE_BASE_URL=https://fakestoreapi.com

# The owner's chosen "top rated" products for the home page, in display order
FEATURED_PRODUCT_IDS=3,5,11,12,18

# Enquiry email. Defaults send to the local Mailpit inbox (http://localhost:8025).
# Port 465 uses TLS from the start; other ports upgrade to TLS when the server supports it.
SALES_INBOX_EMAIL=sales@example.com
EMAIL_FROM="Product Catalogue <no-reply@example.com>"
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
